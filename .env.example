# PlainCents V2 backend configuration (TRD §16).
# Copy to .env and adjust as needed. .env itself is gitignored.

# Path to the V2 SQLite database (separate from V1's plaincents.db, TRD §18.2)
V2_DB_PATH=./plaincents_v2.db

# Allowed frontend origin for CORS during local development (Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

# Logging verbosity
LOG_LEVEL=INFO
